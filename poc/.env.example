# Google OAuth credentials
# 1. Go to https://console.cloud.google.com
# 2. Create a project and enable the Photos Library API
# 3. Create OAuth 2.0 credentials (Desktop app type)
# 4. Download the credentials JSON and fill in below

GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Optional: path to your Apple Photos library (default: ~/Pictures/Photos Library.photoslibrary)
# PHOTOS_LIBRARY_PATH=/path/to/Photos Library.photoslibrary
